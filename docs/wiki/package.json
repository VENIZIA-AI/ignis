{
  "name": "@venizia/ignis-docs",
  "version": "0.2.1-1",
  "description": "Interactive documentation site for the Ignis Framework. Includes a VitePress-powered documentation site with guides, API references, and best practices.",
  "keywords": [
    "api-docs",
    "api-reference",
    "bun",
    "dev-tools",
    "developer-tools",
    "docs",
    "documentation",
    "examples",
    "framework-docs",
    "guide",
    "ignis",
    "nodejs",
    "static-site",
    "tutorials",
    "typescript",
    "venizia",
    "vitepress",
    "wiki"
  ],
  "homepage": "https://ignis.venizia.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "docs/wiki"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "content",
    "!content/changelogs",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "docs:build": "sh ./scripts/docs-build.sh",
    "docs:check-sidebar": "bun scripts/check-sidebar.ts",
    "docs:clean": "sh ./scripts/docs-clean.sh",
    "docs:dev": "vitepress dev site",
    "docs:preview": "vitepress preview site",
    "eslint": "eslint --report-unused-disable-directives .",
    "force-update": "sh ./scripts/force-update.sh",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write"
  },
  "dependencies": {
    "cytoscape": "^3.34.2",
    "dayjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "^0.2.0-3",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.42"
  }
}
