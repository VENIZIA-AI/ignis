{
  "name": "@venizia/ignis-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript server framework that puts enterprise patterns (IoC, Repositories, Decorators) on Hono. Built on Drizzle ORM, Zod validation, and convention-based bootstrapping for Bun and Node.js.",
  "keywords": [
    "backend",
    "bun",
    "decorator",
    "dependency-injection",
    "drizzle-orm",
    "enterprise",
    "framework",
    "hono",
    "ignis",
    "inversion-of-control",
    "monorepo",
    "openapi",
    "postgresql",
    "repository-pattern",
    "rest-api",
    "server",
    "swagger",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "docs/*"
    ],
    "catalog": {
      "@stylistic/eslint-plugin": "^5.10.0",
      "@hono/zod-openapi": "^1.6.3",
      "@scalar/hono-api-reference": "^0.12.26",
      "@socket.io/redis-adapter": "^8.3.0",
      "@socket.io/redis-emitter": "^5.1.0",
      "bullmq": "^6.7.10",
      "dayjs": "^1.11.23",
      "dotenv-flow": "^4.1.0",
      "drizzle-zod": "^0.8.3",
      "eslint": "^10.15.0",
      "hono": "^4.13.23",
      "ioredis": "^6.1.0",
      "pg": "^8.23.1",
      "reflect-metadata": "^0.2.2",
      "tsc-alias": "1.9.12",
      "typescript": "^6.0.3",
      "typesense": "^3.3.0",
      "zod": "^4.6.7",
      "@connectrpc/connect": "^2.3.0",
      "@socket.io/bun-engine": "^0.1.2",
      "@types/bun": "^1.4.5",
      "@types/pg": "^8.23.1",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.4",
      "postgres": "^3.4.9",
      "socket.io": "^4.8.4",
      "socket.io-client": "^4.8.4",
      "oxlint": "1.95.0",
      "oxlint-tsgolint": "7.0.2009",
      "typescript-eslint": "^8.74.0"
    }
  },
  "scripts": {
    "prepare": "if [ -f node_modules/.bin/vulcan ]; then bun node_modules/.bin/vulcan project sync --quiet < /dev/null || echo 'vulcan: sync did not finish: if the config is in the flat shape run bun node_modules/.bin/vulcan config codemod config-groups . --write, else run bun node_modules/.bin/vulcan project sync'; else echo 'vulcan: not installed yet: run bun install'; fi; exit 0",
    "force-update": "bun run --filter \"@venizia/*\" force-update",
    "docs:dev": "bun run --filter \"@venizia/ignis-docs\" docs:dev",
    "purity": "bun packages/dev-configs/dist/cli/index.js check purity --claims scripts/checks/purity/manifest.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "@venizia/vulcan": "0.5.0-10",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
