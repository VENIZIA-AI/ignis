{
  "name": "@venizia/ignis-workspace",
  "version": "0.0.0",
  "description": "High-performance TypeScript server infrastructure framework enterprise patterns (IoC, Repositories, Decorators) with Hono speed (~140k req/s). Built on Drizzle ORM, Zod validation, and convention-based bootstrapping for Bun and Node.js.",
  "keywords": [
    "backend",
    "bun",
    "decorator",
    "dependency-injection",
    "drizzle-orm",
    "enterprise",
    "framework",
    "hono",
    "ignis",
    "inversion-of-control",
    "monorepo",
    "nodejs",
    "openapi",
    "postgresql",
    "repository-pattern",
    "rest-api",
    "server",
    "swagger",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
  "overrides": {
    "@electric-sql/pglite": "0.5.5"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "docs/*"
    ],
    "catalog": {
      "@hono/zod-openapi": "^1.5.1",
      "@minimaltech/eslint-node": "^0.3.0",
      "@scalar/hono-api-reference": "^0.11.11",
      "@socket.io/redis-adapter": "^8.3.0",
      "@socket.io/redis-emitter": "^5.1.0",
      "@types/lodash": "^4.17.23",
      "bullmq": "^5.80.8",
      "dayjs": "^1.11.21",
      "dotenv-flow": "^4.1.0",
      "drizzle-zod": "^0.8.3",
      "eslint": "^10.7.0",
      "hono": "^4.12.30",
      "ioredis": "^5.11.1",
      "pg": "^8.22.0",
      "prettier": "^3.9.5",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.2",
      "tsc-alias": "^1.9.1",
      "tsx": "^4.23.1",
      "typescript": "^6.0.3",
      "typesense": "^3.0.3",
      "zod": "^4.4.3",
      "@connectrpc/connect": "^2.1.2",
      "@socket.io/bun-engine": "^0.1.1",
      "@types/bun": "^1.3.14",
      "@types/pg": "^8.20.0",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "lodash": "^4.18.1",
      "postgres": "^3.4.9",
      "socket.io": "^4.8.3",
      "socket.io-client": "^4.8.3"
    }
  },
  "scripts": {
    "force-update": "bun run --filter \"@venizia/*\" force-update",
    "docs:dev": "bun run --filter \"@venizia/ignis-docs\" docs:dev",
    "mcp:dev": "bun run --filter \"@venizia/ignis-docs\" mcp:dev",
    "purity": "bun scripts/purity/cli.ts"
  }
}
