{
  "name": "@venizia/ignis-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "High-performance TypeScript server infrastructure framework enterprise patterns (IoC, Repositories, Decorators) with Hono speed (~140k req/s). Built on Drizzle ORM, Zod validation, and convention-based bootstrapping for Bun and Node.js.",
  "keywords": [
    "backend",
    "bun",
    "decorator",
    "dependency-injection",
    "drizzle-orm",
    "enterprise",
    "framework",
    "hono",
    "ignis",
    "inversion-of-control",
    "monorepo",
    "nodejs",
    "openapi",
    "postgresql",
    "repository-pattern",
    "rest-api",
    "server",
    "swagger",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "docs/*"
    ],
    "catalog": {
      "@hono/zod-openapi": "^1.6.3",
      "@scalar/hono-api-reference": "^0.12.13",
      "@socket.io/redis-adapter": "^8.3.0",
      "@socket.io/redis-emitter": "^5.1.0",
      "bullmq": "^6.4.0",
      "dayjs": "^1.11.23",
      "dotenv-flow": "^4.1.0",
      "drizzle-zod": "^0.8.3",
      "eslint": "^10.13.0",
      "hono": "^4.13.13",
      "ioredis": "^6.0.0",
      "pg": "^8.23.1",
      "prettier": "^3.9.10",
      "reflect-metadata": "^0.2.2",
      "tsc-alias": "1.9.4",
      "typescript": "^6.0.3",
      "typesense": "^3.2.0",
      "zod": "^4.6.7",
      "@connectrpc/connect": "^2.2.0",
      "@socket.io/bun-engine": "^0.1.2",
      "@types/bun": "^1.4.3",
      "@types/pg": "^8.23.1",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.4",
      "postgres": "^3.4.9",
