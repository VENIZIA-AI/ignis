#!/bin/bash

# =============================================================================
# Pre-commit Hook
# Lints the packages and scripts before allowing commit
# =============================================================================

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Get the root directory of the git repository
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# Lint the packages, scripts/, the root manifest and the files no project reaches
echo "📦 Linting..."
make lint-all

echo ""
echo "✅ Pre-commit checks passed!"
