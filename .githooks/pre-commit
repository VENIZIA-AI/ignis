#!/bin/bash

# =============================================================================
# Pre-commit Hook
# Lints all packages and examples before allowing commit
# =============================================================================

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Get the root directory of the git repository
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# Lint the packages and scripts/, then the examples (which make does not drive)
echo "📦 Linting all packages and examples..."
make lint-all
bun scripts/examples.ts check

echo ""
echo "✅ Pre-commit checks passed!"
