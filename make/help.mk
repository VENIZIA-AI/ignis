# `make help` - the target list. Keep it in step with the other make/*.mk files.
# Every row goes through HELP_ROW, so the descriptions start in one column; widen HELP_WIDTH when
# a longer name is added.

HELP_WIDTH := 38
HELP_ROW = printf "  %-$(HELP_WIDTH)s %s\n"

.PHONY: help

help:
	@echo "Makefile for the @venizia/lib Monorepo"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Main Targets:"
	@$(HELP_ROW) "help" "Show this help message (a bare 'make' does the same)."
	@$(HELP_ROW) "all / build" "Rebuilds all packages (alias for 'build-all')."
	@$(HELP_ROW) "build-all" "Rebuilds all packages in order, then the wiki and its checks."
	@$(HELP_ROW) "install" "Install all dependencies with bun."
	@$(HELP_ROW) "update / update-all" "Force update all packages from NPM registry."
	@$(HELP_ROW) "clean" "Clean build artifacts from all packages."
	@$(HELP_ROW) "setup-hooks" "Configure git to use .githooks directory."
	@$(HELP_ROW) "docs" "Rebuilds wiki (VitePress) for GitHub Pages."
	@echo ""
	@echo "Per package - <pkg> is one of:"
	@echo "  $(PACKAGES)"
	@echo "  core is an alias of core-server in every target: core, lint-core, test-core, ..."
	@$(HELP_ROW) "<pkg>" "Rebuild one package, after its dependencies."
	@$(HELP_ROW) "update-<pkg>" "Force update one package's dependencies from NPM."
	@$(HELP_ROW) "lint-<pkg>" "oxlint + ESLint (naming-convention) + oxfmt check of one package."
	@$(HELP_ROW) "fmt-<pkg>" "Apply oxlint --fix, ESLint --fix and oxfmt to one package."
	@$(HELP_ROW) "test-<pkg>" "Run one package's suite with BUN_TEST_FLAGS. Needs a build."
	@$(HELP_ROW) "purity-<pkg>" "Gate: one package's browser-pure entries. Needs a build."
	@$(HELP_ROW) "clean-install-<pkg>" "Load one package's sub-paths from a clean install. Needs a build."
	@echo ""
	@echo "Every package:"
	@$(HELP_ROW) "lint / lint-packages" "lint-<pkg> for every package."
	@$(HELP_ROW) "lint-all" "lint-packages and lint-scripts."
	@$(HELP_ROW) "fmt / fmt-packages" "fmt-<pkg> for every package."
	@$(HELP_ROW) "test-all" "test-<pkg> for every package with a suite (BUN_TEST_FLAGS, default --parallel)."
	@$(HELP_ROW) "purity" "Gate: every entry claimed browser-pure has no node builtin or global."
	@$(HELP_ROW) "clean-install" "Load every published sub-path from packed tarballs in an empty project."
	@echo ""
	@echo "Repository scripts and wiki:"
	@$(HELP_ROW) "lint-scripts" "Format check + tsc type-check of scripts/."
	@$(HELP_ROW) "lint-wiki" "Lint docs/wiki scripts and check its format."
	@$(HELP_ROW) "test-scripts" "Run the repository gate scripts' own regression tests."
	@$(HELP_ROW) "purity-test" "Run the purity probe's own regression tests."
	@echo ""
	@echo "Knowledge bundle (.agents/knowledge) - okf, surface, symbols, releases come from VULCAN:"
	@$(HELP_ROW) "okf-check" "Gate: OKF v0.2 conformance."
	@$(HELP_ROW) "okf-check-strict" "Gate: OKF v0.2 plus the house rules - links, style, coverage, freshness."
	@$(HELP_ROW) "okf-gen" "Regenerate source-derived reference content."
	@$(HELP_ROW) "okf-coverage" "Report bundle coverage against the source inventory."
	@$(HELP_ROW) "okf-viz" "Build the offline knowledge-graph explorer."
	@$(HELP_ROW) "split-report" "Report hub files, stray types, missing barrels, long files, cycles (informational)."
	@$(HELP_ROW) "surface-gen" "Snapshot every exported symbol into .agents/knowledge/reference/public-surface.md."
	@$(HELP_ROW) "surface-check" "Gate: the public surface equals the snapshot."
	@$(HELP_ROW) "symbols-gen" "Regenerate .agents/knowledge/reference/symbols.json for the Atlas symbol tool."
	@$(HELP_ROW) "symbols-check" "Gate: the symbol table matches the built .d.ts."
	@$(HELP_ROW) "releases-gen" "Regenerate .agents/knowledge/reference/releases.json for the Atlas version and changes tools."
	@$(HELP_ROW) "releases-check" "Gate: the release table matches the release commits and the changelogs."
	@$(HELP_ROW) "wiki-links-check" "Gate: every source path the wiki and knowledge bundle name exists."
	@$(HELP_ROW) "wiki-anchors-check" "Gate: every wiki '#fragment' link resolves. Needs a build (make docs)."
	@$(HELP_ROW) "agent-setup / vulcan-sync" "Write the gitignored agent adapters (CLAUDE.md, .claude/) with VULCAN."
	@$(HELP_ROW) "vulcan-doctor" "Gate: the project follows VULCAN (config, Makefile include, rules, adapters)."
	@echo ""
	@echo "Release and dependencies:"
	@$(HELP_ROW) "release-plan" "Print the release plan (dependency order), dispatch nothing."
	@$(HELP_ROW) "release ARGS=\"...\"" "Dispatch the release workflow per package, e.g. ARGS=\"kernel --mode patch\"."
	@$(HELP_ROW) "catalog-check" "Gate: every catalogued dep is referenced as \"catalog:\", none drifted."
	@echo ""
	@echo "Development (use bun run directly):"
	@$(HELP_ROW) "bun run docs:dev" "Start documentation site in development mode."
	@$(HELP_ROW) "bun x --no-install vulcan x atlas mcp" "Start the atlas MCP server over this repo (VULCAN)."
