{
  "name": "supabase-example",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS on postgres-js with Supabase-style Row Level Security, driven by the request's user",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "dev-configs lint",
    "lint:fix": "dev-configs lint --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh",
    "migrate:generate": "drizzle-kit generate --config=src/migration.ts",
    "token": "bun run src/token-cli.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
