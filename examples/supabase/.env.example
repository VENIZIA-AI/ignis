DEBUG=true
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Application
APP_ENV_APPLICATION_NAME=supabase_example
APP_ENV_APPLICATION_TIMEZONE=Asia/Ho_Chi_Minh

APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs

# Server
APP_ENV_SERVER_HOST=0.0.0.0
APP_ENV_SERVER_PORT=3000
APP_ENV_SERVER_BASE_PATH=/api

# Supabase - Postgres
# The pooler hands you a full URL; it is not assembled from host/port/user parts.
APP_ENV_SUPABASE_DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:<port>/postgres

# direct | session | transaction
# TRANSACTION (Supavisor, usually :6543) rebinds the backend per transaction, so server-side prepared
# statements do not survive - buildPostgresJsOptions() emits `prepare: false` for it. That is a
# requirement, not a tuning knob. DIRECT/SESSION keep prepared statements.
APP_ENV_SUPABASE_POOLER_MODE=session

# Forwarded to postgres-js only when set; leave blank to keep postgres-js's own default.
APP_ENV_SUPABASE_POOL_MAX=

# Supabase - Auth (GoTrue)
APP_ENV_SUPABASE_URL=https://supabase.example.com
APP_ENV_SUPABASE_ANON_KEY=<anon key>

# The project's JWT secret - GoTrue signs HS256 tokens with it, and IGNIS's JWSAuthenticationStrategy
# verifies them with it. Self-hosted: the JWT_SECRET in your Supabase stack's .env.
APP_ENV_JWT_SECRET=<jwt secret>
APP_ENV_JWT_EXPIRES_IN=3600
