NODE_ENV=development

# Application
APP_ENV_APPLICATION_NAME=supabase_example

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs

# DataSource. `docker compose up -d` maps the container's 5432 to this host port.
# Local demo value, not a secret. Set your own outside a local run.
APP_ENV_SUPABASE_DATABASE_URL=postgresql://postgres:postgres@localhost:15433/postgres

# direct | session | transaction - see PoolerModes. A local Postgres has no pooler in front of it, so
# `direct` is correct here; a real Supabase project behind Supavisor would use `session` or
# `transaction` - see "Choose a pooler mode" in the README.
APP_ENV_SUPABASE_POOLER_MODE=direct

# Forwarded to postgres-js only when set; leave blank to keep postgres-js's own default.
APP_ENV_SUPABASE_POOL_MAX=

# HS256 secret this app verifies incoming tokens with, and mints its own test tokens with
# (`bun run token`). On a real Supabase project this is the project's JWT secret.
# Local demo value, not a secret. Set your own outside a local run.
APP_ENV_JWT_SECRET=local-development-secret-change-me
APP_ENV_JWT_EXPIRES_IN=3600

# The iss and aud this app requires of a token (and stamps on its test tokens). Supabase Auth writes
# https://<project>.supabase.co/auth/v1 and "authenticated". These are the local Supabase CLI's.
APP_ENV_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
APP_ENV_JWT_AUDIENCE=authenticated

PORT=3000
