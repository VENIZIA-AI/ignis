NODE_ENV=development

# Application
APP_ENV_APPLICATION_NAME=websocket_test

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs
APP_ENV_LOGGER_FORMAT=json

# The port the HTTP server listens on.
PORT=3000

# Redis backs the WebSocket cross-instance Pub/Sub. `docker-compose.yml` maps its container port to
# 16381 on the host so it never collides with a Redis already running on the default 6379.
APP_ENV_REDIS_HOST=localhost
APP_ENV_REDIS_PORT=16381
APP_ENV_REDIS_PASSWORD=

# Every WebSocket client must send this token in its `authenticate` message to authenticate.
APP_ENV_AUTH_TOKEN=demo-token
