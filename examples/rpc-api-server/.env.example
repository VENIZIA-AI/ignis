NODE_ENV=development

# Application
APP_ENV_APPLICATION_NAME=rpc_api_server

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs
APP_ENV_LOGGER_FORMAT=json

# DataSource. A directory PGlite owns; unset it for an in-memory database that dies with the process.
APP_ENV_PGLITE_DATA_DIR=./app_data/database/pgdata

# Authentication. Required: the HMAC key that signs and verifies every JWT. Generate one with
# `openssl rand -hex 32`; never commit a real value.
APP_ENV_JWT_SECRET=
# Token lifetime in seconds. Default 86400 (one day).
APP_ENV_JWT_EXPIRES_IN=86400
