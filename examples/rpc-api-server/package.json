{
  "name": "rpc-api-server",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS REST API with JWT sign-up and sign-in, protected CRUD and JSX pages, on PGlite",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "NODE_ENV=development APP_ENV_PGLITE_DATA_DIR=./app_data/database/pgdata APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh",
    "migrate:generate": "drizzle-kit generate --config=src/migration.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
