# Copy to .env - Bun and drizzle-kit both load it. Every value matches docker-compose.yml.
APP_ENV_APPLICATION_NAME=vert
APP_ENV_APPLICATION_TIMEZONE=Asia/Ho_Chi_Minh
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs
APP_ENV_LOGGER_FORMAT=text

# Server
APP_ENV_SERVER_HOST=0.0.0.0
APP_ENV_SERVER_PORT=1190
APP_ENV_SERVER_BASE_PATH=/v1/api

# PostgreSQL (docker compose)
APP_ENV_POSTGRES_HOST=127.0.0.1
APP_ENV_POSTGRES_PORT=15434
APP_ENV_POSTGRES_USERNAME=postgres
APP_ENV_POSTGRES_PASSWORD=password
APP_ENV_POSTGRES_DATABASE=vert

# Redis for the authorization cache (docker compose)
APP_ENV_AUTHORZ_REDIS_HOST=127.0.0.1
APP_ENV_AUTHORZ_REDIS_PORT=16382
APP_ENV_AUTHORZ_REDIS_PASSWORD=
APP_ENV_AUTHORZ_REDIS_DB=8

# JWKS: an ES256 key pair in keys/ (the README shows how to make one)
APP_ENV_JWT_EXPIRES_IN=86400
APP_ENV_JWKS_ALGORITHM=ES256
APP_ENV_JWKS_KID=vert-key-1
APP_ENV_JWKS_KEY_DRIVER=file
APP_ENV_JWKS_KEY_FORMAT=pem
APP_ENV_JWKS_PRIVATE_KEY=./keys/private.pem
APP_ENV_JWKS_PUBLIC_KEY=./keys/public.pem

# Set to true to run the repository test suites (src/services/tests) at boot
APP_ENV_RUN_REPOSITORY_TESTS=false
