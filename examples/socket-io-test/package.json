{
  "name": "socket-io-test",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS Socket.IO - Redis-backed rooms behind a mandatory authentication handshake",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "sh ./scripts/clean.sh",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "rebuild": "bun run clean && bun run build",
    "server:dev": "NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "start": "APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@socket.io/bun-engine": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "@socket.io/redis-emitter": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "socket.io": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
