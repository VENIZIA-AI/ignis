{
  "name": "socket-io-test",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS Socket.IO - Redis-backed rooms behind a mandatory authentication handshake",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@socket.io/bun-engine": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "@socket.io/redis-emitter": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "socket.io": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
