NODE_ENV=development

# Application
APP_ENV_APPLICATION_NAME=sqlite_quickstart

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs
APP_ENV_LOGGER_FORMAT=json

# DataSource. `file:` for a local database, `:memory:` to die with the process.
# A remote Turso url cannot hold an explicit transaction.
APP_ENV_SQLITE_URL=file:./app_data/database/local.db
