{
  "name": "rpc-client-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React client for rpc-api-server: typed hooks generated from the IGNIS OpenAPI document",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "vite",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test --pass-with-no-tests",
    "clean": "sh scripts/clean.sh",
    "generate": "openapi-typescript http://localhost:3000/api/doc/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.3.5"
  }
}
