{
  "name": "rpc-client-app",
  "version": "0.0.0",
  "private": true,
  "description": "React client for rpc-api-server: typed hooks generated from the IGNIS OpenAPI document",
  "type": "module",
  "scripts": {
    "server:dev": "vite",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "devz lint",
    "lint:fix": "devz lint --fix",
    "test": "bun test --max-concurrency=6 --pass-with-no-tests",
    "clean": "sh scripts/clean.sh",
    "generate": "openapi-typescript http://localhost:3000/api/doc/openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@venizia/ignis-helpers": "workspace:*",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@venizia/dev-configs": "workspace:*",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "catalog:",
    "openapi-typescript": "^7.13.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.4.0"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
