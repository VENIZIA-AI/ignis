{
  "name": "rpc-client-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React client for rpc-api-server: typed hooks generated from the IGNIS OpenAPI document",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "generate": "openapi-typescript http://localhost:3000/api/doc/openapi.json -o ./src/api/schema.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
