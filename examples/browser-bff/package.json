{
  "name": "browser-bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGNIS as a Backend-for-Frontend inside a browser Worker - the same controllers, served from PGlite in OPFS, with no server running",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "vite build",
    "clean": "sh ./scripts/clean.sh",
    "dev": "vite",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "preview": "vite preview",
    "rebuild": "bun run clean && bun run build",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@electric-sql/pglite": "^0.5.5",
    "@hono/zod-openapi": "catalog:",
    "@minimaltech/ra-core-infra": "0.0.3-17",
    "@reduxjs/toolkit": "^2.12.0",
    "@venizia/ignis-connectors": "workspace:*",
    "@venizia/ignis-filter": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
    "@venizia/ignis-kernel": "workspace:*",
    "@venizia/ignis-worker": "workspace:*",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "lucide-react": "^1.32.0",
    "ra-core": "^5.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "reflect-metadata": "catalog:",
    "socket.io-client": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@venizia/dev-configs": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.1"
  }
}
