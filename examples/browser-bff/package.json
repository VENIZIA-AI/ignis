{
  "name": "browser-bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGNIS as a Backend-for-Frontend inside a browser Worker - the same controllers, served from PGlite in OPFS, with no server running",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "APP_ENV_PGLITE_DATA_DIR=opfs-ahp://ignis-browser-bff vite build",
    "clean": "sh ./scripts/clean.sh",
    "dev": "APP_ENV_PGLITE_DATA_DIR=opfs-ahp://ignis-browser-bff vite",
    "lint": "oxlint -c .configs/oxlint.config.mts --deny-warnings && eslint -c .configs/eslint.config.mjs . && oxfmt -c .configs/oxfmt.config.mts --check \"**/*.{ts,tsx,mts,js,mjs}\"",
    "lint:fix": "oxlint -c .configs/oxlint.config.mts --fix && eslint -c .configs/eslint.config.mjs . --fix && oxfmt -c .configs/oxfmt.config.mts \"**/*.{ts,tsx,mts,js,mjs}\"",
    "preview": "vite preview",
    "rebuild": "bun run clean && bun run build",
    "test": "bun test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/zod-openapi": "catalog:",
    "@minimaltech/ra-core-infra": "0.0.3-17",
    "@reduxjs/toolkit": "^2.12.0",
    "@venizia/ignis-connectors": "workspace:*",
    "@venizia/ignis-filter": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
    "@venizia/ignis-kernel": "workspace:*",
    "@venizia/ignis-worker": "workspace:*",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "lucide-react": "^1.41.0",
    "ra-core": "^5.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "reflect-metadata": "catalog:",
    "socket.io-client": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@venizia/dev-configs": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  }
}
