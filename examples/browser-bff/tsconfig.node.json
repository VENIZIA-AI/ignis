{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.common.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "bundler",

    /* The build tooling, not the application: this project holds `vite.config.ts` alone, which runs
       in node and needs `fileURLToPath`. `node` is scoped here rather than declared once for the
       whole package so it cannot reach `src`. */
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
