{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.common.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "bundler",

    /* The smoke test runs in Bun and loads the Worker by URL, so it needs Bun's types and none of
       the application's. */
    "lib": [
      "ES2024",
      "DOM"
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "test"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
