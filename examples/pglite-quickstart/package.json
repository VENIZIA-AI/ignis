{
  "name": "pglite-quickstart",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS on PGlite - Postgres compiled to WASM, running in-process with no server",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "sh ./scripts/clean.sh",
    "lint": "oxlint -c .configs/oxlint.config.mts --deny-warnings && eslint -c .configs/eslint.config.mjs . && oxfmt -c .configs/oxfmt.config.mts --check \"**/*.{ts,tsx,mts,js,mjs}\"",
    "lint:fix": "oxlint -c .configs/oxlint.config.mts --fix && eslint -c .configs/eslint.config.mjs . --fix && oxfmt -c .configs/oxfmt.config.mts \"**/*.{ts,tsx,mts,js,mjs}\"",
    "migrate:dev": "NODE_ENV=development drizzle-kit migrate --config=src/migration.ts",
    "migrate:generate": "drizzle-kit generate --config=src/migration.ts",
    "rebuild": "bun run clean && bun run build",
    "server:dev": "NODE_ENV=development APP_ENV_PGLITE_DATA_DIR=./app_data/database/pgdata APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "start": "APP_ENV_PGLITE_DATA_DIR=./app_data/database/pgdata APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
