NODE_ENV=development

# Application
APP_ENV_APPLICATION_NAME=typesense_search

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs

# DataSource - matches docker-compose.yml (host port 18108, api-key xyz).
APP_ENV_TYPESENSE_HOST=127.0.0.1
APP_ENV_TYPESENSE_PORT=18108
APP_ENV_TYPESENSE_PROTOCOL=http
APP_ENV_TYPESENSE_API_KEY=xyz
