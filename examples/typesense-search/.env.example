DEBUG=true
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Application
APP_ENV_APPLICATION_NAME=typesense_search_example
APP_ENV_APPLICATION_TIMEZONE=Asia/Ho_Chi_Minh

APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs

# Server
APP_ENV_SERVER_HOST=0.0.0.0
APP_ENV_SERVER_PORT=3000
APP_ENV_SERVER_BASE_PATH=/api

# Typesense - zero Postgres in this example, this is the only datasource
# Cluster mode: comma-separated host:port list (takes precedence over HOST/PORT)
# APP_ENV_TYPESENSE_NODES=node1:8108,node2:8108,node3:8108
APP_ENV_TYPESENSE_HOST=0.0.0.0
APP_ENV_TYPESENSE_PORT=8108
APP_ENV_TYPESENSE_PROTOCOL=http
APP_ENV_TYPESENSE_API_KEY=xyz

# Google/Gemini embedding API key (blank -> use the local ts/all-MiniLM-L6-v2 model instead)
APP_ENV_GOOGLE_API_KEY=
