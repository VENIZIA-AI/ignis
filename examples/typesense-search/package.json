{
  "name": "typesense-search-example",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS reference example for the Typesense search datasource - a pure search API with zero Postgres, demonstrating the connector's optionality",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "sh ./scripts/clean.sh",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "rebuild": "bun run clean && bun run build",
    "seed": "NODE_ENV=development bun run src/seed.ts",
    "server:dev": "NODE_ENV=development bun .",
    "server:prod": "NODE_ENV=production bun ."
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.10.16",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
    "hono": "^4.12.21",
    "typesense": "^3.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.3"
  }
}
