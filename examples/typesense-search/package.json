{
  "name": "typesense-search",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS search API over Typesense - SearchControllerFactory search routes alongside factory CRUD, zero Postgres",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "dev-configs lint",
    "lint:fix": "dev-configs lint --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:",
    "typesense": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
