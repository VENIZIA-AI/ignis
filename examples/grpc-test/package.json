{
  "name": "grpc-test",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS gRPC reference: all four call kinds on Connect, gRPC-Web and native gRPC, with JWT, role policy and a row scope",
  "scripts": {
    "server:dev": "bun run web:build && NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "web:build": "bun scripts/web-build.ts",
    "proto:gen": "buf generate && bun fmt --no-script src/generated",
    "proto:lint": "buf lint",
    "certs": "sh scripts/generate-certs.sh",
    "client:connect": "bun clients/connect-node.ts",
    "client:grpc-js": "bun clients/grpc-js.ts",
    "client:grpcurl": "sh scripts/grpcurl.sh",
    "migrate:generate": "bun --bun drizzle-kit generate --config=src/migration.ts",
    "typecheck": "bun check",
    "lint": "devz lint",
    "lint:fix": "devz lint --fix",
    "test": "bun test --max-concurrency=6",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@connectrpc/connect-web": "^2.3.0",
    "@electric-sql/pglite": "^0.6.1",
    "@hono/zod-openapi": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-connectors": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7",
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
