{
  "name": "grpc-test",
  "version": "0.0.0",
  "private": true,
  "description": "IGNIS gRPC (ConnectRPC) and REST controllers, side by side in one application",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "NODE_ENV=development APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh",
    "proto:gen": "node_modules/.bin/buf generate --template src/controllers/greeter/proto/buf.gen.yaml src/controllers/greeter/proto && bun run prettier:fix"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-web": "^2.1.2",
    "@hono/zod-openapi": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
