{
  "name": "grpc-test",
  "version": "0.0.0",
  "private": true,
  "description": "gRPC example — ConnectRPC server + client with Ignis",
  "main": "dist/index.js",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "clean": "sh ./scripts/clean.sh",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "rebuild": "bun run clean && bun run build",
    "proto:gen": "bun run proto:gen:greeter && bun run proto:gen:health && bun run proto:gen:echo && bun run proto:gen:time",
    "proto:gen:greeter": "node_modules/.bin/buf generate --template src/controllers/greeter/proto/buf.gen.yaml src/controllers/greeter/proto",
    "proto:gen:health": "node_modules/.bin/buf generate --template src/controllers/health/proto/buf.gen.yaml src/controllers/health/proto",
    "proto:gen:echo": "node_modules/.bin/buf generate --template src/controllers/echo/proto/buf.gen.yaml src/controllers/echo/proto",
    "proto:gen:time": "node_modules/.bin/buf generate --template src/controllers/time/proto/buf.gen.yaml src/controllers/time/proto",
    "preserver:dev": "bun run rebuild",
    "server:dev": "NODE_ENV=development bun .",
    "preclient:dev": "bun run rebuild",
    "client:dev": "NODE_ENV=development bun run dist/client.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-web": "^2.1.2",
    "@hono/zod-openapi": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  }
}
