# Copy to .env: cp .env.example .env
# The values below are EXAMPLES for a local run. Change both secrets anywhere else.
NODE_ENV=development

APP_ENV_APPLICATION_NAME=grpc_test

# Ports. Both servers listen on 127.0.0.1 unless you say otherwise.
APP_ENV_SERVER_PORT=3000
APP_ENV_SERVER_HOST=127.0.0.1

# The native gRPC port. 0 takes a free port.
APP_ENV_GRPC_PORT=50051
APP_ENV_GRPC_HOST=127.0.0.1
# false: clear text (h2c). true: TLS with certs/server.key and certs/server.crt (bun run certs).
APP_ENV_GRPC_TLS=false
# Streams one connection may have open at once.
APP_ENV_GRPC_MAX_STREAMS=100
# How long a stop waits for calls in flight before it aborts them.
APP_ENV_GRPC_SHUTDOWN_TIMEOUT_MS=5000

# Authentication. The HMAC key that signs and verifies every token, at least 32 bytes.
# Example value only: generate yours with `openssl rand -base64 48`.
APP_ENV_JWT_SECRET=example-only-jwt-secret-do-not-use-outside-this-demo
# Token lifetime in seconds.
APP_ENV_JWT_EXPIRES_IN=3600
# The password of the demo users alice (editor) and bob (viewer). Example value only.
APP_ENV_DEMO_PASSWORD=example-only-password

# DataSource. A directory PGlite owns; unset, the database is in memory and dies with the process.
# APP_ENV_PGLITE_DATA_DIR=./app_data/database/pgdata

# Logger. File logging is opt-in: with no folder path only the console transport is wired.
APP_ENV_LOGGER_FOLDER_PATH=./app_data/logs
