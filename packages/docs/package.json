{
  "name": "@venizia/ignis-docs",
  "version": "0.0.7-2",
  "description": "Interactive documentation site and MCP (Model Context Protocol) server for the Ignis Framework. Includes a VitePress-powered documentation site with guides, API references, and best practices. Ships an MCP server (CLI: ignis-docs-mcp) with 11 tools for AI assistants to search docs, browse source code, verify dependencies, and access real-time framework knowledge. Built with Mastra MCP SDK and Fuse.js fuzzy search.",
  "keywords": [
    "ai",
    "ai-assistant",
    "ai-development",
    "ai-tools",
    "api-docs",
    "api-reference",
    "bun",
    "claude",
    "claude-code",
    "cli",
    "cli-tool",
    "code-search",
    "copilot",
    "cursor",
    "dev-tools",
    "developer-tools",
    "docs",
    "documentation",
    "examples",
    "framework-docs",
    "fuse.js",
    "fuzzy-search",
    "guide",
    "ignis",
    "llm",
    "llm-tools",
    "mastra",
    "mastra-mcp",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nodejs",
    "static-site",
    "tutorials",
    "typescript",
    "venizia",
    "vitepress",
    "wiki",
    "windsurf"
  ],
  "homepage": "https://venizia-ai.github.io/ignis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/docs"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "main": "./dist/mcp-server/index.js",
  "types": "./dist/mcp-server/index.d.ts",
  "bin": {
    "ignis-docs-mcp": "./dist/mcp-server/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server/index.d.ts",
      "default": "./dist/mcp-server/index.js"
    },
    "./tools": {
      "types": "./dist/mcp-server/tools/index.d.ts",
      "default": "./dist/mcp-server/tools/index.js"
    },
    "./helpers": {
      "types": "./dist/mcp-server/helpers/index.d.ts",
      "default": "./dist/mcp-server/helpers/index.js"
    },
    "./common": {
      "types": "./dist/mcp-server/common/index.d.ts",
      "default": "./dist/mcp-server/common/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist/mcp-server",
    "wiki",
    "!wiki/changelogs",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ./scripts/force-update.sh",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "docs:dev": "vitepress dev site",
    "docs:clean": "sh ./scripts/docs-clean.sh",
    "docs:build": "sh ./scripts/docs-build.sh",
    "docs:preview": "vitepress preview site",
    "rebuild": "sh ./scripts/mcp-rebuild.sh no-version",
    "mcp:rebuild": "bun run rebuild",
    "mcp:build": "sh ./scripts/mcp-build.sh",
    "mcp:clean": "sh ./scripts/mcp-clean.sh",
    "mcp:start": "bun run mcp-server/index.ts",
    "mcp:dev": "bun --watch mcp-server/index.ts",
    "prepublishOnly": "bun run mcp:rebuild"
  },
  "dependencies": {
    "@mastra/core": "^1.5.0",
    "@mastra/mcp": "^1.0.1",
    "cytoscape": "^3.33.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.19",
    "debug": "^4.4.3",
    "fast-glob": "^3.3.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@types/bun": "^1.3.9",
    "@venizia/dev-configs": "^0.0.6",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.28"
  }
}
