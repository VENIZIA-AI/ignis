{
  "name": "@venizia/ignis-inversion",
  "version": "0.4.3",
  "description": "A small, standalone Dependency Injection and Inversion of Control container for TypeScript. Features decorator-based constructor and property injection, fluent Binding API, singleton/transient scoping, namespace auto-tagging, Provider pattern, tag-based discovery, and reflect-metadata integration. Zero framework lock-in — works standalone or with Ignis.",
  "keywords": [
    "architecture",
    "binding",
    "bun",
    "clean-architecture",
    "constructor-injection",
    "container",
    "decorator",
    "decorators",
    "dependency-injection",
    "design-patterns",
    "di",
    "di-container",
    "fluent-api",
    "ignis",
    "inject",
    "injectable",
    "injection",
    "injector",
    "inversion-of-control",
    "ioc",
    "ioc-container",
    "lightweight",
    "loose-coupling",
    "metadata",
    "nodejs",
    "property-injection",
    "provider",
    "reflect-metadata",
    "scope",
    "scoped",
    "service-container",
    "service-locator",
    "singleton",
    "solid",
    "tag-discovery",
    "testability",
    "transient",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/inversion"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/cjs/index.js",
    "./dist/esm/index.js"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
