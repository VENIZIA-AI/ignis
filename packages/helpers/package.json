      "default": "./dist/modules/secrets/dotenv/index.js"
    },
    "./winston": {
      "types": "./dist/modules/logger/winston/index.d.ts",
      "default": "./dist/modules/logger/winston/index.js"
    },
    "./pino": {
      "types": "./dist/modules/logger/pino/index.d.ts",
