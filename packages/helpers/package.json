{
  "name": "@venizia/ignis-helpers",
  "version": "0.0.8-6",
  "description": "Production-ready TypeScript utility library with 14+ modules: Winston logging with daily rotation, Redis single/cluster with pub/sub, BullMQ/MQTT/Kafka message queues, MinIO/Disk/Memory object storage, AES-256/RSA/ECDH cryptography, Snowflake UID generation (4M IDs/sec), cron scheduling, Socket.IO/WebSocket real-time communication, TCP/TLS/UDP networking, HTTP clients, worker thread pools, and environment management. Sub-path imports isolate optional peer dependencies for optimal tree-shaking and bundle size.",
  "keywords": [
    "aes",
    "aes-256",
    "aws-s3",
    "axios",
    "base62",
    "bullmq",
    "bun",
    "cron",
    "cron-scheduler",
    "cronjob",
    "crypto",
    "cryptography",
    "disk-storage",
    "ecdh",
    "encryption",
    "env",
    "environment",
    "event-driven",
    "file-storage",
    "file-upload",
    "helpers",
    "http-client",
    "ignis",
    "ioredis",
    "job-queue",
    "kafka",
    "library",
    "log-management",
    "log-rotation",
    "logger",
    "logging",
    "message-queue",
    "minio",
    "mqtt",
    "network",
    "nodejs",
    "object-storage",
    "production-ready",
    "pub-sub",
    "pubsub",
    "queue",
    "real-time",
    "redis",
    "redis-cluster",
    "rsa",
    "s3",
    "s3-compatible",
    "scheduler",
    "snowflake",
    "snowflake-id",
    "socket.io",
    "storage",
    "sub-path-exports",
    "tcp",
    "thread-pool",
    "tls",
    "tools",
    "tree-shaking",
    "typescript",
    "udp",
    "uid",
    "unique-id",
    "utilities",
    "utils",
    "venizia",
    "websocket",
    "winston",
    "worker-thread"
  ],
  "homepage": "https://venizia-ai.github.io/ignis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/helpers"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./socket-io": {
      "types": "./dist/modules/socket/socket-io/index.d.ts",
      "default": "./dist/modules/socket/socket-io/index.js"
    },
    "./bullmq": {
      "types": "./dist/modules/queue/bullmq/index.d.ts",
      "default": "./dist/modules/queue/bullmq/index.js"
    },
    "./mqtt": {
      "types": "./dist/modules/queue/mqtt/index.d.ts",
      "default": "./dist/modules/queue/mqtt/index.js"
    },
    "./minio": {
      "types": "./dist/modules/storage/minio/index.d.ts",
      "default": "./dist/modules/storage/minio/index.js"
    },
    "./bun-s3": {
      "types": "./dist/modules/storage/bun-s3/index.d.ts",
      "default": "./dist/modules/storage/bun-s3/index.js"
    },
    "./axios": {
      "types": "./dist/modules/network/http-request/fetcher/axios-fetcher.d.ts",
      "default": "./dist/modules/network/http-request/fetcher/axios-fetcher.js"
    },
    "./cron": {
      "types": "./dist/modules/cron/index.d.ts",
      "default": "./dist/modules/cron/index.js"
    },
    "./kafka": {
      "types": "./dist/modules/queue/kafka/index.d.ts",
      "default": "./dist/modules/queue/kafka/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/tests",
    "!/**/dist/tests",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "force-update": "sh ./scripts/force-update.sh",
    "build": "sh ./scripts/build.sh",
    "clean": "sh ./scripts/clean.sh",
    "eslint": "eslint --report-unused-disable-directives .",
    "lint": "bun run eslint && bun run prettier:cli",
    "lint:fix": "bun run eslint --fix && bun run prettier:fix",
    "prettier:cli": "prettier \"**/*.{js,ts}\" -l",
    "prettier:fix": "bun run prettier:cli --write",
    "rebuild": "sh ./scripts/rebuild.sh no-version",
    "prepublishOnly": "bun run rebuild"
  },
  "dependencies": {
    "@venizia/ignis-inversion": "^0.0.5",
    "drizzle-orm": "^0.45.2",
    "dayjs": "^1.11.20",
    "hono": "^4.12.9",
    "ioredis": "5.9.3",
    "lodash": "^4.17.23",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "peerDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.14.0",
    "bullmq": "^5.71.1",
    "cron": "^4.3.3",
    "minio": "^8.0.6",
    "mqtt": "^5.15.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "@platformatic/kafka": "^1.31.0"
  },
  "peerDependenciesMeta": {
    "@socket.io/redis-adapter": {
      "optional": true
    },
    "@socket.io/redis-emitter": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "cron": {
      "optional": true
    },
    "minio": {
      "optional": true
    },
    "mqtt": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "@platformatic/kafka": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/zod-openapi": "^1.2.4",
    "@platformatic/kafka": "1.31.0",
    "@types/bun": "^1.3.11",
    "@types/lodash": "^4.17.23",
    "@venizia/dev-configs": "^0.0.6",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2"
  }
}
