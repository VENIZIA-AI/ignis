{
  "name": "@venizia/dev-configs",
  "version": "0.3.3",
  "description": "Shareable development configurations for TypeScript projects: oxlint and oxfmt presets with per-rule builders, the ESLint naming-convention rule, the legacy ESLint flat config and Prettier presets, and TypeScript compiler options with critical decorator support (experimentalDecorators, emitDecoratorMetadata, useDefineForClassFields). Single source of truth for consistent code style, type checking, and build settings across monorepo packages.",
  "keywords": [
    "build-tools",
    "bun",
    "code-quality",
    "code-style",
    "compiler-options",
    "configurations",
    "decorator",
    "decorator-support",
    "dev-configs",
    "dev-tools",
    "development",
    "emit-decorator-metadata",
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "eslint-plugin-unicorn",
    "eslint-v9",
    "experimental-decorators",
    "format",
    "formatter",
    "ignis",
    "lint",
    "linter",
    "monorepo",
    "monorepo-config",
    "nodejs",
    "oxfmt",
    "oxlint",
    "prettier",
    "prettier-config",
    "settings",
    "shareable-config",
    "shared-config",
    "tsconfig",
    "tsconfig-base",
    "tsconfig-shared",
    "typescript",
    "typescript-config",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/dev-configs"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compilers": {
      "types": "./dist/compilers/index.d.ts",
      "default": "./dist/compilers/index.js"
    },
    "./formatters": {
      "types": "./dist/formatters/index.d.ts",
      "default": "./dist/formatters/index.js"
    },
    "./linters": {
      "types": "./dist/linters/index.d.ts",
      "default": "./dist/linters/index.js"
    },
    "./linters/oxlint": {
      "types": "./dist/linters/oxlint-presets.d.ts",
      "default": "./dist/linters/oxlint-presets.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./tsconfig.base.json": "./src/tsconfig/tsconfig.base.json",
    "./tsconfig.common.json": "./src/tsconfig/tsconfig.common.json",
    "./tsconfig.browser.json": "./src/tsconfig/tsconfig.browser.json",
    "./tsconfig.react.json": "./src/tsconfig/tsconfig.react.json",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "src/tsconfig",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ./scripts/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "oxfmt": ">=0.73.0",
    "oxlint": ">=1.88.0",
    "oxlint-tsgolint": ">=7.0.2004",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
