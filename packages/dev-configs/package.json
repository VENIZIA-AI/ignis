{
  "name": "@venizia/dev-configs",
  "version": "0.4.1",
  "description": "Shareable development configurations for TypeScript projects: oxlint presets with per-rule builders, the ESLint naming-convention rule, the legacy ESLint flat config, and TypeScript compiler options with critical decorator support (experimentalDecorators, emitDecoratorMetadata, useDefineForClassFields). Single source of truth for consistent code style, type checking, and build settings across monorepo packages.",
  "keywords": [
    "build-tools",
    "bun",
    "code-quality",
    "code-style",
    "compiler-options",
    "configurations",
    "decorator",
    "decorator-support",
    "dev-configs",
    "dev-tools",
    "development",
    "emit-decorator-metadata",
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "eslint-plugin-unicorn",
    "eslint-v9",
    "experimental-decorators",
    "format",
    "formatter",
    "ignis",
    "lint",
    "linter",
    "monorepo",
    "monorepo-config",
    "nodejs",
    "oxlint",
    "settings",
    "shareable-config",
    "shared-config",
    "tsconfig",
    "tsconfig-base",
    "tsconfig-shared",
    "typescript",
    "typescript-config",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/dev-configs"
  },
  "bin": {
    "devz": "./dist/cli/index.js"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "src/tsconfig",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compilers": {
      "types": "./dist/compilers/index.d.ts",
      "default": "./dist/compilers/index.js"
    },
    "./linters": {
      "types": "./dist/linters/index.d.ts",
      "default": "./dist/linters/index.js"
    },
    "./linters/oxlint": {
      "types": "./dist/linters/oxlint-presets.d.ts",
      "default": "./dist/linters/oxlint-presets.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./tsconfig.base.json": "./src/tsconfig/tsconfig.base.json",
    "./tsconfig.common.json": "./src/tsconfig/tsconfig.common.json",
    "./tsconfig.browser.json": "./src/tsconfig/tsconfig.browser.json",
    "./tsconfig.react.json": "./src/tsconfig/tsconfig.react.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "oxlint": ">=1.89.0",
    "oxlint-tsgolint": ">=7.0.2004",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
