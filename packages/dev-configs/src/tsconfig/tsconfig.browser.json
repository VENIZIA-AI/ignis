{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* A browser library: a bundler (Vite, webpack) resolves the imports, the DOM is there, Bun is not */
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
