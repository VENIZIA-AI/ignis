{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./src/tsconfig/tsconfig.common.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
