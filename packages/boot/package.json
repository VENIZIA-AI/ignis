{
  "name": "@venizia/ignis-boot",
  "version": "0.4.3",
  "description": "Build-time artifact index generator for IGNIS applications: scans decorated classes with the TypeScript AST and emits one static registration file per package, so bun build --compile sees plain imports.",
  "keywords": [
    "artifact-index",
    "build-time",
    "code-generation",
    "decorators",
    "dependency-injection",
    "di",
    "ignis",
    "ioc",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/boot"
  },
  "bin": {
    "ignis-artifacts": "./dist/esm/clis/artifacts.js"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/esm/bun/auto.js"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./generator": {
      "types": "./dist/esm/generator/index.d.ts",
      "default": "./dist/esm/generator/index.js"
    },
    "./bun": {
      "types": "./dist/esm/bun/index.d.ts",
      "default": "./dist/esm/bun/index.js"
    },
    "./auto": {
      "types": "./dist/esm/bun/auto.d.ts",
      "default": "./dist/esm/bun/auto.js"
    },
    "./vite": {
      "types": "./dist/esm/vite/index.d.ts",
      "default": "./dist/esm/vite/index.js"
    },
    "./build-info": {
      "types": "./dist/esm/build-info/index.d.ts",
      "default": "./dist/esm/build-info/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
