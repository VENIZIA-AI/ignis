{
  "name": "@venizia/ignis-boot",
  "version": "0.2.1-7",
  "description": "Build-time artifact index generator for IGNIS applications: scans decorated classes with the TypeScript AST and emits one static registration file per package, so bun build --compile sees plain imports.",
  "keywords": [
    "artifact-index",
    "build-time",
    "code-generation",
    "decorators",
    "dependency-injection",
    "di",
    "ignis",
    "ioc",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/boot"
  },
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./generator": {
      "types": "./dist/cjs/generator/index.d.ts",
      "import": "./dist/esm/generator/index.js",
      "require": "./dist/cjs/generator/index.js",
      "default": "./dist/cjs/generator/index.js"
    },
    "./bun": {
      "types": "./dist/cjs/bun/index.d.ts",
      "import": "./dist/esm/bun/index.js",
      "require": "./dist/cjs/bun/index.js",
      "default": "./dist/cjs/bun/index.js"
    },
    "./auto": {
      "types": "./dist/cjs/bun/auto.d.ts",
      "import": "./dist/esm/bun/auto.js",
      "require": "./dist/cjs/bun/auto.js",
      "default": "./dist/cjs/bun/auto.js"
    },
    "./build-info": {
      "types": "./dist/cjs/build-info/index.d.ts",
      "import": "./dist/esm/build-info/index.js",
      "require": "./dist/cjs/build-info/index.js",
      "default": "./dist/cjs/build-info/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/tests",
    "!/**/dist/tests",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/cjs/bun/auto.js",
    "./dist/esm/bun/auto.js"
  ],
  "scripts": {
    "force-update": "sh ./scripts/force-update.sh",
    "prepublishOnly": "make rebuild",
    "test": "NODE_ENV=test bun test --env-file=.env.test",
    "test:watch": "NODE_ENV=test bun test --watch --env-file=.env.test"
  },
  "dependencies": {
    "@venizia/ignis-helpers": "^0.2.2-6",
    "@venizia/ignis-inversion": "^0.2.2-3"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "^0.3.1-1",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "bin": {
    "ignis-artifacts": "./dist/cjs/clis/artifacts.js",
    "ignis-build-info": "./dist/cjs/clis/build-info.js"
  }
}
