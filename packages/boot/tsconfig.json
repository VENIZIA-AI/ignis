{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.common.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "dist/cjs",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "./*.config.*",
    ".prettierrc.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app_data",
    "src/__tests__/fixtures/artifacts"
  ]
}
