{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/esm",
    "declaration": true,
    "declarationDir": "../../dist/esm"
  },
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../app_data",
    "../../**/__tests__",
    "../../**/*.test.ts",
    "../../**/*.spec.ts"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
