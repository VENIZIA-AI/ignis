{
  "name": "@venizia/ignis",
  "version": "0.4.3",
  "description": "TypeScript server framework with decorator-based DI, the repository pattern and a component system, on Hono. Features auto-generated OpenAPI docs, Drizzle ORM type-safe SQL, JWT/Basic authentication, Casbin authorization, convention-based bootstrapping, and pluggable components for health checks, Swagger UI, mail, Socket.IO, and static assets. Built for Bun and Node.js.",
  "keywords": [
    "access-control",
    "amazon-ses",
    "api",
    "api-documentation",
    "authentication",
    "authorization",
    "backend",
    "bun",
    "casbin",
    "class-based",
    "component",
    "controller",
    "crud",
    "database",
    "datasource",
    "decorator",
    "dependency-injection",
    "di",
    "drizzle",
    "drizzle-orm",
    "enterprise",
    "file-upload",
    "framework",
    "health-check",
    "high-performance",
    "hono",
    "http",
    "ignis",
    "infrastructure",
    "inversion-of-control",
    "ioc",
    "jose",
    "jwt",
    "mail",
    "middleware",
    "mixin",
    "model",
    "nodejs",
    "nodemailer",
    "openapi",
    "orm",
    "postgres",
    "postgresql",
    "rbac",
    "real-time",
    "repository-pattern",
    "rest",
    "rest-api",
    "restful",
    "router",
    "routing",
    "scalar",
    "schema-validation",
    "security",
    "server",
    "service",
    "socket.io",
    "soft-delete",
    "static-assets",
    "swagger",
    "swagger-ui",
