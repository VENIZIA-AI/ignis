    "typescript",
    "validation",
    "venizia",
    "web-framework",
    "websocket",
    "zod"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/core-server"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/connectors/postgres/index.d.ts",
      "default": "./dist/connectors/postgres/index.js"
    },
    "./relational": {
      "types": "./dist/connectors/relational/index.d.ts",
      "default": "./dist/connectors/relational/index.js"
    },
    "./postgres/node-postgres": {
      "types": "./dist/connectors/postgres/drivers/node-postgres.d.ts",
      "default": "./dist/connectors/postgres/drivers/node-postgres.js"
    },
    "./postgres/postgres-js": {
      "types": "./dist/connectors/postgres/drivers/postgres-js.d.ts",
      "import": "./dist/connectors/postgres/drivers/postgres-js.mjs",
      "default": "./dist/connectors/postgres/drivers/postgres-js.js"
    },
    "./postgres/pglite": {
      "types": "./dist/connectors/postgres/drivers/pglite.d.ts",
      "default": "./dist/connectors/postgres/drivers/pglite.js"
    },
    "./postgres/supabase": {
      "types": "./dist/connectors/postgres/supabase/index.d.ts",
      "default": "./dist/connectors/postgres/supabase/index.js"
    },
    "./sqlite": {
      "types": "./dist/connectors/sqlite/index.d.ts",
      "default": "./dist/connectors/sqlite/index.js"
    },
    "./sqlite/libsql": {
      "types": "./dist/connectors/sqlite/drivers/libsql.d.ts",
      "default": "./dist/connectors/sqlite/drivers/libsql.js"
    },
    "./search": {
      "types": "./dist/connectors/search/index.d.ts",
      "default": "./dist/connectors/search/index.js"
    },
    "./search/controllers": {
      "types": "./dist/connectors/search/controllers/index.d.ts",
      "default": "./dist/connectors/search/controllers/index.js"
    },
    "./meilisearch": {
      "types": "./dist/connectors/meilisearch/index.d.ts",
      "default": "./dist/connectors/meilisearch/index.js"
    },
    "./socket-io": {
      "types": "./dist/components/socket-io/index.d.ts",
      "default": "./dist/components/socket-io/index.js"
    },
    "./mail": {
      "types": "./dist/components/mail/index.d.ts",
      "default": "./dist/components/mail/index.js"
    },
    "./grpc": {
      "types": "./dist/components/controller/grpc/index.d.ts",
      "default": "./dist/components/controller/grpc/index.js"
    },
    "./static-asset": {
      "types": "./dist/components/static-asset/index.d.ts",
      "default": "./dist/components/static-asset/index.js"
    },
    "./websocket": {
      "types": "./dist/components/websocket/index.d.ts",
      "default": "./dist/components/websocket/index.js"
    },
    "./typesense": {
      "types": "./dist/connectors/typesense/index.d.ts",
      "default": "./dist/connectors/typesense/index.js"
    },
    "./typesense/controllers": {
      "types": "./dist/connectors/typesense/controllers/index.d.ts",
      "default": "./dist/connectors/typesense/controllers/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ./src",
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@venizia/ignis-connectors": "workspace:*",
    "@venizia/ignis-filter": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
