{
  "presetVersion": 1,
  "side": "backend",
  "summary": "An IGNIS API on Bun: one controller, AutoArtifacts, the API reference at /api/doc/explorer.",
  "devPort": 3000,
  "urls": ["/api/hello", "/api/doc/explorer"],
  "imports": { "#src/*.json": "./src/*.json", "#src/*": "./src/*.js" },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "peers": {},
  "scripts": {
    "server:dev": "NODE_ENV=development bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh"
  },
  "checks": ["typecheck", "lint", "test"],
  "files": "./files",
  "atlas": [{ "name": "ignis", "repo": "VENIZIA-AI/ignis", "ref": "develop" }]
}
