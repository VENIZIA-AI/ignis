{
  "presetVersion": 1,
  "side": "backend",
  "summary": "An IGNIS API on Bun: one controller, AutoArtifacts, the API reference at /api/doc/explorer.",
  "devPort": 3000,
  "urls": ["/api/hello", "/api/doc/explorer"],
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@venizia/ignis": "workspace:*",
    "@venizia/ignis-boot": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "hono": "catalog:",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peers": {},
  "scripts": {
    "dev": "NODE_ENV=development bun run src/index.ts",
    "start": "NODE_ENV=production bun run dist/index.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c .configs/oxlint.config.mts --deny-warnings && eslint -c .configs/eslint.config.mjs . && oxfmt -c .configs/oxfmt.config.mts --check \"**/*.{ts,tsx,mts,js,mjs}\"",
    "lint:fix": "oxlint -c .configs/oxlint.config.mts --fix && eslint -c .configs/eslint.config.mjs . --fix && oxfmt -c .configs/oxfmt.config.mts \"**/*.{ts,tsx,mts,js,mjs}\"",
    "test": "bun test"
  },
  "checks": ["typecheck", "lint", "test"],
  "files": "./files",
  "atlas": [{ "name": "ignis", "repo": "VENIZIA-AI/ignis", "ref": "develop" }]
}
