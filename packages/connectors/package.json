{
  "name": "@venizia/ignis-connectors",
  "version": "0.4.5",
  "description": "Datasource and repository connectors for the IGNIS framework: the engine-neutral relational and search tiers, plus Postgres, SQLite, PGlite, Typesense and Meilisearch behind sub-paths.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/connectors"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./http": {
      "types": "./dist/esm/http/index.d.ts",
      "default": "./dist/esm/http/index.js"
    },
    "./raw-sql": {
      "types": "./dist/esm/raw-sql/index.d.ts",
      "default": "./dist/esm/raw-sql/index.js"
    },
    "./relational": {
      "types": "./dist/esm/relational/core/index.d.ts",
      "default": "./dist/esm/relational/core/index.js"
    },
    "./postgres": {
      "types": "./dist/esm/relational/postgres/index.d.ts",
      "default": "./dist/esm/relational/postgres/index.js"
    },
    "./postgres/node-postgres": {
      "types": "./dist/esm/relational/postgres/drivers/node-postgres.d.ts",
      "default": "./dist/esm/relational/postgres/drivers/node-postgres.js"
    },
    "./postgres/postgres-js": {
      "types": "./dist/esm/relational/postgres/drivers/postgres-js.d.ts",
      "default": "./dist/esm/relational/postgres/drivers/postgres-js.js"
    },
    "./postgres/pglite": {
      "types": "./dist/esm/relational/postgres/drivers/pglite.d.ts",
      "default": "./dist/esm/relational/postgres/drivers/pglite.js"
    },
    "./postgres/supabase": {
      "types": "./dist/esm/relational/postgres/supabase/index.d.ts",
      "default": "./dist/esm/relational/postgres/supabase/index.js"
    },
    "./sqlite": {
      "types": "./dist/esm/relational/sqlite/index.d.ts",
      "default": "./dist/esm/relational/sqlite/index.js"
    },
    "./sqlite/libsql": {
      "types": "./dist/esm/relational/sqlite/drivers/libsql.d.ts",
      "default": "./dist/esm/relational/sqlite/drivers/libsql.js"
    },
    "./search": {
      "types": "./dist/esm/search/core/index.d.ts",
      "default": "./dist/esm/search/core/index.js"
    },
    "./search/controllers": {
      "types": "./dist/esm/search/core/controllers/index.d.ts",
      "default": "./dist/esm/search/core/controllers/index.js"
    },
    "./typesense": {
      "types": "./dist/esm/search/typesense/index.d.ts",
      "default": "./dist/esm/search/typesense/index.js"
    },
    "./typesense/controllers": {
      "types": "./dist/esm/search/typesense/controllers/index.d.ts",
      "default": "./dist/esm/search/typesense/controllers/index.js"
    },
    "./meilisearch": {
      "types": "./dist/esm/search/meilisearch/index.d.ts",
      "default": "./dist/esm/search/meilisearch/index.js"
    },
    "./testing": {
      "types": "./dist/esm/testing/index.d.ts",
      "default": "./dist/esm/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@venizia/ignis-filter": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
    "@venizia/ignis-kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "meilisearch": "^0.62.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "typesense": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@hono/zod-openapi": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "drizzle-zod": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "meilisearch": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "typesense": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  }
}
