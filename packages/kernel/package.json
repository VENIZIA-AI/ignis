{
  "name": "@venizia/ignis-kernel",
  "version": "0.4.6-0",
  "description": "Browser-pure kernel of the IGNIS framework: dependency injection, lifecycle, REST controllers, repository and datasource abstractions, and the authentication and authorization seams. No node builtin and no server-only peer, so the same kernel serves a Bun server and a browser Worker.",
  "keywords": [
    "authentication",
    "authorization",
    "browser",
    "component",
    "controller",
    "dependency-injection",
    "di",
    "ignis",
    "ioc",
    "isomorphic",
    "kernel",
    "repository-pattern",
    "rest",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ignis.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ignis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ignis.git",
    "directory": "packages/kernel"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "./dist/esm/index.js"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./metadata": {
      "types": "./dist/esm/metadata.d.ts",
      "default": "./dist/esm/metadata.js"
    },
    "./repository": {
      "types": "./dist/esm/repository.d.ts",
      "default": "./dist/esm/repository.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@venizia/ignis-filter": "workspace:*",
    "@venizia/ignis-helpers": "workspace:*",
    "@venizia/ignis-inversion": "workspace:*",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "workspace:*",
    "casbin": "^5.51.1",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "casbin": "^5.51.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  },
  "peerDependenciesMeta": {
    "@hono/zod-openapi": {
      "optional": true
    },
    "casbin": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "jose": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  }
}
